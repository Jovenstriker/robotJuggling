<!--
  Planar, free-standing juggler: the torso can slide in x (forward), z (up) and
  pitch about y, so the robot must balance on its feet and step to follow the
  ball. Each leg has hip / knee / ankle pitch. The ball also moves in the x-z plane.
  The legs sit at y = +-0.07 with wide feet so a ball at y = 0 lands on either.
-->
<mujoco model="soccer_juggler_walk">
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <visual>
    <global offwidth="1280" offheight="720"/>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.6 0.6 0.6"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.20 0.45 0.20" rgb2="0.17 0.40 0.17" width="512" height="512"/>
    <material name="grass" texture="grid" texrepeat="40 4" reflectance="0.05"/>
    <texture name="ball_tex" type="cube" builtin="checker" rgb1="0.95 0.95 0.95" rgb2="0.1 0.1 0.1" width="64" height="64"/>
    <material name="ball_mat" texture="ball_tex"/>
    <material name="robot" rgba="0.75 0.78 0.82 1"/>
    <material name="joint" rgba="0.25 0.28 0.32 1"/>
    <material name="boot" rgba="0.85 0.25 0.15 1"/>
    <material name="boot_l" rgba="0.15 0.35 0.85 1"/>
  </asset>

  <default>
    <joint damping="2" armature="0.02"/>
    <geom contype="1" conaffinity="1" friction="0.9 0.02 0.002" material="robot"/>
    <position kp="400" forcerange="-300 300"/>
    <!-- legs collide with floor and ball (group 1/2 bits) but not with each other -->
    <default class="leg">
      <geom contype="2" conaffinity="1"/>
    </default>
  </default>

  <worldbody>
    <light pos="0 -1 3" dir="0 0.3 -1" directional="true"/>
    <geom name="floor" type="plane" size="20 2 0.1" material="grass" contype="1" conaffinity="3"/>

    <body name="torso" pos="0 0 0.935">
      <joint name="root_x" type="slide" axis="1 0 0" damping="0" armature="0"/>
      <joint name="root_z" type="slide" axis="0 0 1" damping="0" armature="0"/>
      <joint name="root_pitch" type="hinge" axis="0 1 0" damping="0" armature="0"/>
      <geom name="pelvis" type="box" size="0.08 0.14 0.06" mass="8" contype="0" conaffinity="0"/>
      <geom name="chest" type="box" size="0.10 0.14 0.20" pos="0 0 0.28" mass="14" contype="0" conaffinity="0"/>

      <!-- right leg (red boot) -->
      <body name="r_thigh" pos="0 -0.07 -0.04" childclass="leg">
        <joint name="r_hip" type="hinge" axis="0 1 0" range="-110 45"/>
        <geom name="r_hip_cap" type="sphere" size="0.065" material="joint" contype="0" conaffinity="0"/>
        <geom name="r_thigh" type="capsule" fromto="0 0 0 0 0 -0.42" size="0.05" mass="4.0"/>
        <body name="r_shin" pos="0 0 -0.42">
          <joint name="r_knee" type="hinge" axis="0 1 0" range="0 140"/>
          <geom name="r_knee_cap" type="sphere" size="0.05" material="joint" contype="0" conaffinity="0"/>
          <geom name="r_shin" type="capsule" fromto="0 0 0 0 0 -0.42" size="0.04" mass="2.0"/>
          <body name="r_foot" pos="0 0 -0.45">
            <joint name="r_ankle" type="hinge" axis="0 1 0" range="-45 85"/>
            <geom name="r_foot" type="box" size="0.13 0.065 0.025" pos="0.05 0 0" mass="0.8" material="boot"/>
            <site name="r_foot_top" pos="0.05 0.07 0.025" size="0.01"/>
          </body>
        </body>
      </body>

      <!-- left leg (blue boot) -->
      <body name="l_thigh" pos="0 0.07 -0.04" childclass="leg">
        <joint name="l_hip" type="hinge" axis="0 1 0" range="-110 45"/>
        <geom name="l_hip_cap" type="sphere" size="0.065" material="joint" contype="0" conaffinity="0"/>
        <geom name="l_thigh" type="capsule" fromto="0 0 0 0 0 -0.42" size="0.05" mass="4.0"/>
        <body name="l_shin" pos="0 0 -0.42">
          <joint name="l_knee" type="hinge" axis="0 1 0" range="0 140"/>
          <geom name="l_knee_cap" type="sphere" size="0.05" material="joint" contype="0" conaffinity="0"/>
          <geom name="l_shin" type="capsule" fromto="0 0 0 0 0 -0.42" size="0.04" mass="2.0"/>
          <body name="l_foot" pos="0 0 -0.45">
            <joint name="l_ankle" type="hinge" axis="0 1 0" range="-45 85"/>
            <geom name="l_foot" type="box" size="0.13 0.065 0.025" pos="0.05 0 0" mass="0.8" material="boot_l"/>
            <site name="l_foot_top" pos="0.05 -0.07 0.025" size="0.01"/>
          </body>
        </body>
      </body>
    </body>

    <!-- planar ball at y = 0 -->
    <body name="ball" pos="0.7 0 1.2">
      <joint name="ball_x" type="slide" axis="1 0 0" damping="0" armature="0"/>
      <joint name="ball_z" type="slide" axis="0 0 1" damping="0" armature="0"/>
      <joint name="ball_rot" type="hinge" axis="0 1 0" damping="0" armature="0"/>
      <geom name="ball" type="sphere" size="0.11" mass="0.43" material="ball_mat"
            solref="-20000 -8" solimp="0.95 0.99 0.001" friction="0.6 0.01 0.001"
            condim="3" priority="1" contype="1" conaffinity="3"/>
    </body>
  </worldbody>

  <actuator>
    <position name="r_hip"   joint="r_hip"   ctrlrange="-110 45"/>
    <position name="r_knee"  joint="r_knee"  ctrlrange="0 140"  kp="300"/>
    <position name="r_ankle" joint="r_ankle" ctrlrange="-45 85" kp="150"/>
    <position name="l_hip"   joint="l_hip"   ctrlrange="-110 45"/>
    <position name="l_knee"  joint="l_knee"  ctrlrange="0 140"  kp="300"/>
    <position name="l_ankle" joint="l_ankle" ctrlrange="-45 85" kp="150"/>
  </actuator>
</mujoco>
